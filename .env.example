# Shared
APP_ENV=development
OPERATION_MODE=SIGNAL_ONLY
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/trado
# Required to authenticate mutating API requests (POST/PUT/PATCH/DELETE).
# If empty, the API is unauthenticated — only acceptable in local development.
API_KEY=
# Comma-separated list of origins allowed by CORS. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:3000
ENABLED_TIMEFRAMES=5m,15m,1h,4h
MIN_SIGNAL_SCORE=60
MIN_RISK_REWARD=2.0
MIN_AVERAGE_QUOTE_VOLUME_USD=50000

# Hyperliquid
HYPERLIQUID_NETWORK=testnet
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=
ENABLE_LIVE_TRADING=false
ENABLE_MAINNET_LIVE_TRADING=false
LIVE_MIN_ACCOUNT_VALUE_USD=100
LIVE_ORDER_NOTIONAL_CAP_USD=250
LIVE_MAX_SLIPPAGE_PCT=0.5
LIVE_ORDER_EXPIRES_AFTER_SECONDS=30

# External market intelligence
COINMARKETCAP_API_KEY=
COINMARKETCAP_ENABLED=true
COINMARKETCAP_BASE_URL=https://pro-api.coinmarketcap.com
COINMARKETCAP_QUOTA_COOLDOWN_SECONDS=86400
COINMARKETCAP_USAGE_CACHE_TTL_SECONDS=300
COINMARKETCAP_MIN_CREDITS_LEFT=1
EXTERNAL_QUOTE_ENRICHMENT_ENABLED=false
EXTERNAL_MARKET_DATA_CACHE_TTL_SECONDS=21600
COINGECKO_ENABLED=true
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
FEAR_GREED_WEIGHT=4
ALTCOIN_SEASON_WEIGHT=4

# Optional whale-flow provider
WHALE_ALERT_API_KEY=
WHALE_ALERT_BASE_URL=https://api.whale-alert.io/v1
WHALE_ALERT_PUBLIC_URL=https://whale-alert.io/data.json
WHALE_ALERT_PUBLIC_ALERTS=10
WHALE_ALERT_PUBLIC_CACHE_TTL_SECONDS=600
WHALE_ALERT_MIN_VALUE_USD=500000
WHALE_ALERT_LOOKBACK_MINUTES=60
WHALE_FLOW_WEIGHT=6
WHALE_CONTRA_BLOCK_CONFIDENCE=70

# Risk controls
KILL_SWITCH_ENABLED=false
MAX_RISK_PER_TRADE_PCT=1
MAX_DAILY_LOSS_PCT=3
MAX_OPEN_POSITIONS=5
MAX_TOTAL_EXPOSURE_PCT=25
MAX_LEVERAGE=3
PAPER_EQUITY=10000

# Alerts — ADMIN bot (private DMs to you only).
# Used for recap_orario (with HL balances), worker errors, live position
# notifications. This bot should NOT be admin of the public channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Chat ID of the PUBLIC signals channel. Signals + share cards are posted
# here via the PUBLIC bot below (LANDING_BOT_TOKEN). Format: -100xxxxxxxxxx.
TELEGRAM_SIGNAL_CHAT_ID=

# Landing page + onboarding bot (Telegram funnel) — PUBLIC bot.
# Separate bot from the admin one above. Must be admin of the channel
# referenced by TELEGRAM_SIGNAL_CHAT_ID, with "post messages" and "invite
# users via link" permissions. If left empty, public channel posting and the
# onboarding bot both fall back to TELEGRAM_BOT_TOKEN (legacy single-bot mode).
LANDING_BOT_TOKEN=
# Public username of the bot (without @) — the landing page builds
# https://t.me/<username>?start=<source> deep links from this.
LANDING_BOT_USERNAME=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_OPERATION_MODE=SIGNAL_ONLY
NEXT_PUBLIC_HYPERLIQUID_NETWORK=testnet
# Must match API_KEY above; the frontend sends it as X-API-Key on mutating requests.
NEXT_PUBLIC_API_KEY=
